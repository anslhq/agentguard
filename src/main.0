            if n >= 5 && cmd.value[0] == ('d' as u8) && cmd.value[1] == ('o' as u8) && cmd.value[2] == ('a' as u8) && cmd.value[3] == ('s' as u8) && cmd.value[4] == (' ' as u8) {
