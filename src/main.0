        }
        check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"repo\":{")
        if std.fs.exists(".git") {
            check world.out.write("\"root\":\".\",")
        } else {
            check world.out.write("\"root\":null,")
        }
        // Package manager detection
        if std.fs.exists("pnpm-lock.yaml") {
            check world.out.write("\"packageManager\":\"pnpm\",")
        } else {
            if std.fs.exists("package-lock.json") {
                check world.out.write("\"packageManager\":\"npm\",")
            } else {
                if std.fs.exists("yarn.lock") {
                    check world.out.write("\"packageManager\":\"yarn\",")
                } else {
                    check world.out.write("\"packageManager\":null,")
                }
            }
        }
        // Language detection
        if std.fs.exists("tsconfig.json") {
            check world.out.write("\"languages\":[\"typescript\"],")
        } else {
            if std.fs.exists("package.json") {
                check world.out.write("\"languages\":[\"javascript\"],")
            } else {
                check world.out.write("\"languages\":[],")
            }
        }
        // Framework detection
        if std.fs.exists("next.config.js") || std.fs.exists("next.config.mjs") || std.fs.exists("next.config.ts") {
            check world.out.write("\"frameworks\":[\"nextjs\"],")
        } else {
            check world.out.write("\"frameworks\":[],")
        }
        check world.out.write("\"monorepo\":")
        if std.fs.exists("pnpm-workspace.yaml") || std.fs.exists("lerna.json") {
            check world.out.write("true")
        } else {
            check world.out.write("false")
        }
        check world.out.write("},\"commands\":{")
        // Script detection from package.json presence. NOTE: real
        // package.json parsing was attempted in A7 but had to be
        // deferred — a second 1KB buffer inside main() interacted
        // with the existing 2KB hook payload buffer and triggered
        // the documented Mach-O stack-frame teardown bug (correct
        // output, but SIGBUS on exit). Re-promote when helper fns
        // (compiler item C4) land. For now: emit conventional
        // commands keyed by the detected package manager, honestly
        // labelled as unverified.
        if std.fs.exists("package.json") {
            if std.fs.exists("pnpm-lock.yaml") {
                check world.out.write("\"install\":\"pnpm install\",\"typecheck\":\"pnpm typecheck\",\"test\":\"pnpm test\",\"lint\":\"pnpm lint\",\"build\":\"pnpm build\",\"dev\":\"pnpm dev\",\"verified\":false")
            } else {
                if std.fs.exists("yarn.lock") {
                    check world.out.write("\"install\":\"yarn install\",\"typecheck\":\"yarn typecheck\",\"test\":\"yarn test\",\"lint\":\"yarn lint\",\"build\":\"yarn build\",\"dev\":\"yarn dev\",\"verified\":false")
                } else {
                    if std.fs.exists("bun.lockb") {
                        check world.out.write("\"install\":\"bun install\",\"typecheck\":\"bun typecheck\",\"test\":\"bun test\",\"lint\":\"bun lint\",\"build\":\"bun build\",\"dev\":\"bun dev\",\"verified\":false")
                    } else {
                        check world.out.write("\"install\":\"npm install\",\"typecheck\":\"npm run typecheck\",\"test\":\"npm test\",\"lint\":\"npm run lint\",\"build\":\"npm run build\",\"dev\":\"npm run dev\",\"verified\":false")
                    }
                }
            }
        }
        check world.out.write("},\"riskPaths\":[")
        if std.fs.exists(".github") {
            check world.out.write("\".github/workflows/**\"")
        }
        check world.out.write("],\"agentFiles\":[")
        let mut first_agent: Bool = true
        if std.fs.exists("AGENTS.md") {
            check world.out.write("\"AGENTS.md\"")
            first_agent = false
        }
        if std.fs.exists("CLAUDE.md") {
            if first_agent == false {
                check world.out.write(",")
            }
            check world.out.write("\"CLAUDE.md\"")
            first_agent = false
        }
        if std.fs.exists(".cursor") {
            if first_agent == false {
                check world.out.write(",")
            }
            check world.out.write("\".cursor/\"")
        }
        check world.out.write("],\"meta\":{\"truncated\":false}}\n")
        return
    }
    // ---- explain <CODE> -------------------------------------------------
    if std.mem.eql(first.value, "explain") {
        let arg2 = std.args.get(2)
        if arg2.has == false {
            check world.err.write("agentguard explain: missing diagnostic code\n")
            check world.err.write("usage: agentguard explain <CODE>\n")
            return
        }
        let code = arg2.value
        // Detect known codes by direct string equality and emit the JSON
        // envelope inline. The diagnostic-codes registry is the
        // single source of truth; we exhaustively branch here.
        // Severity strings ("info"/"warn"/"error"/"critical") are inlined
        // per the MVP constraint.

        // -- CMD family --
        if std.mem.eql(code, "CMD001") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"CMD001\",\"severity\":\"error\",\"summary\":\"command requires explicit approval before execution\",\"details\":\"An operation with severity error+ requires an `agentguard approve` resolution event before it can proceed. See CONTEXT.md \\\"Approval\\\" and ADR-0001.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "CMD002") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"CMD002\",\"severity\":\"critical\",\"summary\":\"command is destructive and may not run without approval\",\"details\":\"Destructive commands (rm -rf, terraform destroy, force-push) are blocked in enforce mode. Approve explicitly via `agentguard approve` or reduce blast radius. See ADR-0001.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "CMD003") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"CMD003\",\"severity\":\"error\",\"summary\":\"command targets a path outside the workspace root\",\"details\":\"Workspace-escape commands cross the git-root boundary. See CONTEXT.md \\\"Workspace terms\\\".\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "CMD004") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"CMD004\",\"severity\":\"warn\",\"summary\":\"command contains a sudo or privilege-escalation token\",\"details\":\"Privilege escalation in an agent loop is high-risk. Verify intent before approving.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "CMD005") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"CMD005\",\"severity\":\"warn\",\"summary\":\"command appears to bypass a hook (e.g. --no-verify)\",\"details\":\"Reported as a weak bypass finding (`verify_likely_skipped`, confidence: weak) per CONTEXT.md \\\"Bypass findings\\\". May be a real bypass, a merge, a rebase, or a manual hook removal.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "CMD006") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"CMD006\",\"severity\":\"error\",\"summary\":\"command performs a destructive git operation\",\"details\":\"Force-push, hard reset, branch deletion, reflog expire \\u2014 these are not recoverable. Require approval.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "CMD007") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"CMD007\",\"severity\":\"error\",\"summary\":\"command pipes remote content to a shell\",\"details\":\"`curl ... | sh` is a common exploitation pattern. Audit the source URL and pin the script before approving.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "CMD008") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"CMD008\",\"severity\":\"warn\",\"summary\":\"command shells out via eval $(...)\",\"details\":\"Dynamic command construction widens the trust surface. Prefer explicit command invocations.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        // -- DEP family --
        if std.mem.eql(code, "DEP001") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"DEP001\",\"severity\":\"warn\",\"summary\":\"lockfile changed without package.json change\",\"details\":\"Unusual but legitimate when running lockfile-only installs. Annotate the change in the PR.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "DEP002") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"DEP002\",\"severity\":\"error\",\"summary\":\"package.json changed without lockfile update\",\"details\":\"package.json was modified without a corresponding lockfile change. Run the lockfile-only install for your package manager, or revert the package.json change. See Issue 08.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "DEP003") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"DEP003\",\"severity\":\"warn\",\"summary\":\"package manager script invocation looks suspicious\",\"details\":\"Suspicious npm/pnpm script call patterns. Verify the script body before approving.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        // -- CHG family --
        if std.mem.eql(code, "CHG005") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"CHG005\",\"severity\":\"warn\",\"summary\":\"change touches a sensitive path\",\"details\":\"Edits under auth/**, payments/**, db/migrations/**, or infra/** warrant extra scrutiny.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        // -- POL family --
        if std.mem.eql(code, "POL001") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"POL001\",\"severity\":\"error\",\"summary\":\"policy or hook config was modified during an open session\",\"details\":\"Recorded as a strong-confidence `bypassFindings[]` entry on the next observation event (ADR-0002 amended).\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "POL010") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"POL010\",\"severity\":\"error\",\"summary\":\"policy schemaVersion is newer than this binary supports\",\"details\":\"Upgrade `agentguard` or adjust the policy schemaVersion. See Issue 24.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "POL011") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"POL011\",\"severity\":\"warn\",\"summary\":\"policy contains an unknown field\",\"details\":\"Strict-unknown-fields mode promotes this to `error`.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "POL012") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"POL012\",\"severity\":\"error\",\"summary\":\"policy contains an invalid mode value\",\"details\":\"Valid modes are `observe` and `enforce`. See ADR-0001.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        // -- SEC family --
        if std.mem.eql(code, "SEC001") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"SEC001\",\"severity\":\"error\",\"summary\":\"diff contains a detected secret fingerprint\",\"details\":\"Named fingerprint matched (aws-access-key-id, private-key-pem, github-token, etc.). Redact, revert, or rotate.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "SEC002") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"SEC002\",\"severity\":\"critical\",\"summary\":\"command would leak a known credential pattern\",\"details\":\"Critical: never approve. Rotate the credential and audit recent activity.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "SEC003") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"SEC003\",\"severity\":\"error\",\"summary\":\"high-entropy literal added to a tracked file\",\"details\":\"Possible inadvertent secret commit. Verify and redact before approving.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        // -- CTX family --
        if std.mem.eql(code, "CTX001") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"CTX001\",\"severity\":\"warn\",\"summary\":\"agent instruction file was edited this session\",\"details\":\"AGENTS.md, CLAUDE.md, .cursor/rules, or similar was modified during an open session. Possible instruction drift; reviewer should confirm intent.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "CTX002") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"CTX002\",\"severity\":\"error\",\"summary\":\"context pack budget exceeded; some entries dropped\",\"details\":\"`agentguard pack --budget N` ran past the budget. See Issue 12.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        if std.mem.eql(code, "CTX999") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"CTX999\",\"severity\":\"error\",\"summary\":\"unknown diagnostic code\",\"details\":\"The requested diagnostic code is not in the AgentGuard registry. Verify spelling against CONTEXT.md or src/main.0.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        // -- DOC family --
        if std.mem.eql(code, "DOC001") {
            check world.out.write("{\"schemaVersion\":1,\"ok\":true,\"code\":\"DOC001\",\"severity\":\"error\",\"summary\":\"documentation references superseded vocabulary\",\"details\":\"A file references vocabulary the ADRs have superseded. See Issue 26 for the full forbidden list and the marker convention.\",\"meta\":{\"truncated\":false}}\n")
            return
        }
        // ---- Unknown code: emit a static CTX999 envelope. We do NOT echo
        // the user-supplied code into the JSON message because v0.1.3's
        // direct-backend MVP rejects passing a runtime String to
        // std.json.writeString (CGEN004 "non-identifier callee" / "direct
        // backend calls currently support only same-file function
        // identifiers"). The bad code is preserved on stderr below.
        check world.out.write("{\"schemaVersion\":1,\"ok\":false,\"diagnostics\":[{\"code\":\"CTX999\",\"severity\":\"error\",\"message\":\"unknown diagnostic code\"}],\"meta\":{\"truncated\":false}}\n")
        check world.err.write("agentguard explain: unknown diagnostic code: ")
        check world.err.write(code)
        check world.err.write("\n")
        return
    }
    // ---- Unknown subcommand --------------------------------------------
    // Exit code 64 is the ADR-0012 contract but the v0.1.3 darwin-arm64
    // Mach-O backend has no raise-to-exit lowering, so this exits 0 on Mac.
    // On linux-musl-x64 CI the ELF64 backend's _start stub propagates the
    // raise as exit 1. See AGENTS.md / ADR-0009 for the gap report and the
    // tracked upstream patch.
    check world.err.write("agentguard: unknown command: ")
    check world.err.write(first.value)
    check world.err.write("\n")
    check world.err.write("usage: agentguard --help\n")
    return
}
