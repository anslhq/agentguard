{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "agentguard hook --host cursor --event beforeShellExecution",
        "timeout": 5000
      }
    ],
    "beforeReadFile": [
      {
        "command": "agentguard hook --host cursor --event beforeReadFile",
        "timeout": 5000
      }
    ],
    "afterFileEdit": [
      {
        "command": "agentguard hook --host cursor --event afterFileEdit",
        "timeout": 5000
      }
    ],
    "afterShellExecution": [
      {
        "command": "agentguard hook --host cursor --event afterShellExecution --log-only",
        "timeout": 5000
      }
    ],
    "stop": [
      {
        "command": "agentguard hook --host cursor --event stop",
        "timeout": 5000
      }
    ],
    "sessionStart": [
      {
        "command": "agentguard hook --host cursor --event sessionStart --log-only",
        "timeout": 5000
      }
    ],
    "sessionEnd": [
      {
        "command": "agentguard hook --host cursor --event sessionEnd --log-only",
        "timeout": 5000
      }
    ]
  }
}
