// Issue 00 spike: pattern-matching capability for the AgentGuard rule DSL.
//
// The released Zero v0.1.3 has no full regex engine. CONTEXT.md "Rule" already
// committed to **structured matchers** (anchored substring, glob, named
// fingerprints) — this spike confirms that decision was correct and the
// required primitives are present.
//
// Outcome: structured matchers using `std.mem.eql` + slice-based prefix
// checks, all backed by IR opcodes that exist in v0.1.3. ADR-0009 outcome C
// (the structured-matcher branch), not blocked by missing regex.

pub fun main(world: World) -> Void raises {
    // Exact-match (first-token) — backed by IR_VALUE_BYTE_VIEW_EQ (now
    // implemented on Mach-O via the AgentGuard upstream patch).
    let first = std.args.get(1)
    if first.has && std.mem.eql(first.value, "rm") {
        check world.out.write("exact-match: rm\n")
        return
    }

    // Prefix check via `std.mem.len` + indexed-byte equality. These primitives
    // (IR_VALUE_BYTE_VIEW_LEN, IR_VALUE_BYTE_VIEW_INDEX_LOAD) are present in
    // every emitter.
    if first.has {
        let n: usize = std.mem.len(first.value)
        if n >= 6 && first.value[0] == ('s' as u8) && first.value[1] == ('u' as u8) && first.value[2] == ('d' as u8) && first.value[3] == ('o' as u8) {
            check world.out.write("prefix-match: sudo*\n")
            return
        }
    }

    check world.out.write("no-match\n")
}
