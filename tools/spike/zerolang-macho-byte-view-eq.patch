+      macho_patch_cond19(text, mismatch, text->len);
+      macho_emit_movz_w(text, reg, 0);
+      // 7. Common exit.
+      macho_patch_branch26(text, end_patch_eq, text->len);
+      macho_patch_branch26(text, end_patch_neq, text->len);
+      return true;
+    }
